# Copy this file to .env.local. NEVER commit .env.local.

# PayPal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# QRIS manual: taruh QRIS merchant kamu di public/qris.png

# Email notifications (Resend)
RESEND_API_KEY=your_resend_api_key
BRAND_ORDER_EMAIL=your_order_email@example.com
BRAND_FROM_EMAIL=16flames <orders@your-verified-domain.com>

# Virtual Account (gunakan nilai publik hanya jika memang sengaja ditampilkan di storefront)
NEXT_PUBLIC_VA_BCA=
NEXT_PUBLIC_VA_BCA_NAME=
NEXT_PUBLIC_VA_MANDIRI=
NEXT_PUBLIC_VA_MANDIRI_NAME=
NEXT_PUBLIC_VA_BNI=
NEXT_PUBLIC_VA_BNI_NAME=
NEXT_PUBLIC_VA_BRI=
NEXT_PUBLIC_VA_BRI_NAME=
NEXT_PUBLIC_VA_PERMATA=
NEXT_PUBLIC_VA_PERMATA_NAME=
NEXT_PUBLIC_VA_CIMB=
NEXT_PUBLIC_VA_CIMB_NAME=

# ADMIN LOGIN - production WAJIB diisi. Buat hash dengan: npm run admin:hash -- "password-kamu"
ADMIN_USERNAME=change-me
ADMIN_PASSWORD_HASH=generated-scrypt-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional: only needed to enable protected email test endpoints in production
TEST_EMAIL_SECRET=replace-with-another-random-secret

# MAINTENANCE MODE (wajib untuk ON/OFF online tanpa deploy ulang)
# Buat database Redis gratis di Upstash, lalu masukkan dua nilai ini ke Vercel.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Malaysia manual payment (do not put secrets here)
NEXT_PUBLIC_DUITNOW_QR_IMAGE=/duitnow.png
NEXT_PUBLIC_DUITNOW_MERCHANT_NAME=16FLAMES MALAYSIA
NEXT_PUBLIC_MY_BANK_NAME=
NEXT_PUBLIC_MY_BANK_ACCOUNT=
NEXT_PUBLIC_MY_BANK_HOLDER=
